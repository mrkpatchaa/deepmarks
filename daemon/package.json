{
    "name": "daemon",
    "version": "0.1.0",
    "private": true,
    "description": "Deepmarks companion MCP daemon — Native Messaging host + HTTP MCP server",
    "type": "module",
    "main": "dist/index.cjs",
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:crypto --minify",
        "dev": "node --watch dist/index.cjs",
        "typecheck": "tsc --noEmit",
        "install:daemon": "node scripts/install.js"
    },
    "dependencies": {
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/node": "25.7.0",
        "esbuild": "0.28.0",
        "typescript": "6.0.3"
    }
}